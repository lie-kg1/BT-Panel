# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Required outside local development
SESSION_SECRET=replace-with-a-long-random-secret
SESSION_COOKIE_NAME=botpanel.sid

# Optional storage location for uploaded background media
MEDIA_DIR=./media

# Optional owner bootstrap values for owner.sh
OWNER_USERNAME=admin
OWNER_EMAIL=admin@example.com
OWNER_PASSWORD=replace-before-use

# Optional Spotify Developer app integration
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://localhost:3000/api/spotify/callback
SPOTIFY_MARKET=US
