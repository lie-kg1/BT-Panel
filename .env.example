# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Required outside local development
SESSION_SECRET=replace-with-a-long-random-secret
SESSION_COOKIE_NAME=botpanel.sid

# Optional storage location for uploaded background media
MEDIA_DIR=./media

# Optional owner bootstrap values for owner.sh
OWNER_USERNAME=admin
OWNER_EMAIL=admin@example.com
OWNER_PASSWORD=replace-before-use

# Optional Jtg-style game-server runtime settings
# Use a persistent directory on a real Docker host for server files and backups.
BT_PANEL_RUNTIME_DIR=./
# Set this only when Docker uses a non-default socket path.
DOCKER_SOCKET_PATH=/var/run/docker.sock
