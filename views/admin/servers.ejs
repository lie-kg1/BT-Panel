<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Game Servers — BT Panel</title>
    <link rel="stylesheet" href="/css/panel.css" />
    <link rel="stylesheet" href="/css/servers.css" />
  </head>
  <body class="servers-page">
    <main class="server-shell">
      <header class="server-header">
        <div>
          <a class="server-back-link" href="/">← BT Panel</a>
          <h1>Game Servers</h1>
          <p>Manage Java servers, Docker containers, files, backups, and console commands.</p>
        </div>
        <div class="server-header-actions">
          <span class="server-runtime-badge" id="runtimeBadge">Loading</span>
          <button class="server-button secondary" type="button" id="refreshServersButton">Refresh</button>
          <button class="server-button primary" type="button" id="openCreateServerButton">Create server</button>
        </div>
      </header>

      <div class="server-notice" id="serverNotice" hidden></div>
      <section class="server-stat-grid" aria-label="Server summary">
        <div class="server-stat"><span>Servers</span><strong id="serverCount">0</strong></div>
        <div class="server-stat"><span>Java servers</span><strong id="javaCount">0</strong></div>
        <div class="server-stat"><span>Online</span><strong id="onlineCount">0</strong></div>
        <div class="server-stat"><span>Docker</span><strong id="dockerState">Unavailable</strong></div>
      </section>

      <section class="server-layout">
        <div class="server-card fleet-card">
          <div class="server-card-heading"><div><h2>Your servers</h2><p>Admins see the complete fleet; members see servers assigned to them.</p></div></div>
          <div class="server-list" id="serverList"><div class="server-empty">Loading servers…</div></div>
        </div>
        <div class="server-card node-card">
          <div class="server-card-heading"><div><h2>Nodes</h2><p>Docker runtime and node connectivity.</p></div><button class="server-icon-button" type="button" id="openNodeButton" aria-label="Add node">+</button></div>
          <div class="node-list" id="nodeList"><div class="server-empty">Loading nodes…</div></div>
        </div>
      </section>

      <section class="server-card detail-card" id="serverDetail" hidden>
        <div class="server-card-heading detail-heading">
          <div><span class="server-kicker">Selected server</span><h2 id="detailServerName">—</h2><p id="detailServerMeta">—</p></div>
          <div class="detail-actions" id="detailActions"></div>
        </div>
        <nav class="server-tabs" aria-label="Server management tabs">
          <button class="server-tab active" type="button" data-tab="console">Console</button>
          <button class="server-tab" type="button" data-tab="files">Files</button>
          <button class="server-tab" type="button" data-tab="backups">Backups</button>
          <button class="server-tab" type="button" data-tab="packages">Plugins &amp; Mods</button>
          <button class="server-tab" type="button" data-tab="settings">Settings</button>
        </nav>

        <div class="server-tab-panel active" data-panel="console">
          <div class="console-toolbar"><span id="consoleStatus">Console ready</span><button class="server-button secondary" type="button" id="refreshStatsButton">Refresh stats</button></div>
          <pre class="console-output" id="consoleOutput">Select a server to begin.</pre>
          <form class="console-form" id="consoleForm"><input id="consoleCommand" autocomplete="off" placeholder="Type a server command, for example: say Hello" /><button class="server-button primary" type="submit">Send</button></form>
          <div class="resource-grid" id="resourceGrid"><span>CPU —</span><span>RAM —</span><span>Disk —</span><span>Network —</span></div>
        </div>

        <div class="server-tab-panel" data-panel="files">
          <div class="file-toolbar"><input id="filePath" value="/" aria-label="Current file path" /><button class="server-button secondary" type="button" id="loadFilesButton">Open</button><button class="server-button secondary" type="button" id="uploadFileButton">Upload</button><input type="file" id="serverFileInput" hidden /></div>
          <div class="file-actions"><button class="server-button secondary" type="button" id="newFileButton">New file</button><button class="server-button secondary" type="button" id="newFolderButton">New folder</button><button class="server-button secondary" type="button" id="saveFileButton" disabled>Save editor</button></div>
          <div class="file-manager-grid"><div class="file-list" id="fileList"><div class="server-empty">Open a directory to list files.</div></div><textarea class="file-editor" id="fileEditor" placeholder="Select a small text file to edit." spellcheck="false"></textarea></div>
        </div>

        <div class="server-tab-panel" data-panel="backups">
          <div class="panel-row"><div><h3>Backups</h3><p>Create ZIP snapshots of this server’s files.</p></div><button class="server-button primary" type="button" id="createBackupButton">Create backup</button></div>
          <div class="backup-list" id="backupList"><div class="server-empty">No backups loaded.</div></div>
        </div>

        <div class="server-tab-panel" data-panel="packages">
          <div class="panel-row"><div><h3>Modrinth installer</h3><p>Install a permitted plugin or mod by its Modrinth project ID.</p></div></div>
          <form class="package-form" id="packageForm"><select id="packageKind"><option value="plugin">Plugin</option><option value="mod">Mod</option></select><input id="packageProjectId" placeholder="Modrinth project ID" required /><button class="server-button primary" type="submit">Install</button></form>
          <div class="server-help">Restart the server after installing a package. Only install software you trust and have permission to use.</div>
        </div>

        <div class="server-tab-panel" data-panel="settings">
          <div class="settings-form"><label>Display name<input id="editServerName" maxlength="80" /></label><label>Address alias<input id="editServerAlias" maxlength="120" placeholder="play.example.com:25565" /></label><label>RAM (GB)<input id="editServerRam" type="number" min="1" max="1024" /></label><label>CPU (%)<input id="editServerCpu" type="number" min="1" max="10000" /></label><label>Disk (GB)<input id="editServerDisk" type="number" min="1" max="10240" /></label><button class="server-button primary" type="button" id="saveServerButton">Save settings</button></div>
          <div class="danger-zone"><div><h3>Administrative controls</h3><p>Suspend stops power actions. Delete permanently removes the server container and files.</p></div><div class="detail-actions"><button class="server-button warning" type="button" id="suspendServerButton">Suspend</button><button class="server-button danger" type="button" id="deleteServerButton">Delete server</button></div></div>
        </div>
      </section>
    </main>

    <dialog class="server-dialog" id="createServerDialog"><form method="dialog" id="createServerForm"><div class="dialog-heading"><div><span class="server-kicker">Jtg-style provisioning</span><h2>Create game server</h2></div><button class="server-close" value="cancel" aria-label="Close">×</button></div><div class="settings-form"><label>Name<input id="newServerName" required maxlength="80" placeholder="Survival SMP" /></label><label>Type<select id="newServerType"><option value="PAPER">Paper</option><option value="VANILLA">Vanilla</option><option value="FABRIC">Fabric</option><option value="FORGE">Forge</option><option value="VELOCITY">Velocity</option></select></label><label>Version<input id="newServerVersion" value="latest" maxlength="32" /></label><label>Port<input id="newServerPort" type="number" value="25565" min="1" max="65535" /></label><label>RAM (GB)<input id="newServerRam" type="number" value="2" min="1" max="1024" /></label><label>Disk (GB)<input id="newServerDisk" type="number" value="10" min="1" max="10240" /></label><button class="server-button primary" value="default" type="submit">Create server</button></div></form></dialog>

    <dialog class="server-dialog" id="nodeDialog"><form method="dialog" id="nodeForm"><div class="dialog-heading"><div><span class="server-kicker">Infrastructure</span><h2>Add Docker node</h2></div><button class="server-close" value="cancel" aria-label="Close">×</button></div><div class="settings-form"><label>Node name<input id="newNodeName" required maxlength="80" placeholder="Game node 1" /></label><label>Host or IP<input id="newNodeHost" required maxlength="255" placeholder="203.0.113.10" /></label><label>Docker API port<input id="newNodePort" type="number" value="2375" min="1" max="65535" /></label><label>Scheme<select id="newNodeScheme"><option value="http">HTTP</option><option value="https">HTTPS</option></select></label><button class="server-button primary" value="default" type="submit">Add node</button></div></form></dialog>

    <div class="server-toast" id="serverToast" role="status" aria-live="polite"></div>
    <script>
      const state = { overview: { nodes: [], servers: [], javaServers: 0, dockerAvailable: false }, selected: null, currentPath: "/", file: null, statsTimer: null };
      const $ = (id) => document.getElementById(id);
      const escapeHtml = (value) => String(value ?? "").replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;").replace(/'/g, "&#39;");
      const toast = (message, type = "info") => { const el = $("serverToast"); el.textContent = message; el.dataset.type = type; el.classList.add("visible"); setTimeout(() => el.classList.remove("visible"), 3200); };
      async function api(url, options = {}) { const response = await fetch(url, { credentials: "same-origin", ...options }); const body = await response.json().catch(() => ({})); if (response.status === 401) { window.location.href = "/login"; throw new Error("Authentication required"); } if (!response.ok || body.success === false) throw new Error(body.message || body.error || `Request failed (${response.status})`); return body; }
      function formatBytes(value) { const bytes = Number(value || 0); if (bytes < 1024) return `${bytes} B`; if (bytes < 1024 ** 2) return `${(bytes / 1024).toFixed(1)} KB`; if (bytes < 1024 ** 3) return `${(bytes / 1024 ** 2).toFixed(1)} MB`; return `${(bytes / 1024 ** 3).toFixed(1)} GB`; }
      function renderOverview() {
        const servers = state.overview.servers || []; const nodes = state.overview.nodes || [];
        $("serverCount").textContent = servers.length; $("javaCount").textContent = state.overview.javaServers ?? servers.filter((server) => server.java).length; $("onlineCount").textContent = servers.filter((server) => server.status === "online").length; $("dockerState").textContent = state.overview.dockerAvailable ? "Ready" : "Unavailable"; $("runtimeBadge").textContent = state.overview.sandboxMode ? "Demo mode" : (state.overview.dockerAvailable ? "Docker ready" : "No Docker");
        $("serverList").innerHTML = servers.length ? servers.map((server) => `<article class="server-list-item ${state.selected?.id === server.id ? "selected" : ""}"><button class="server-list-main" type="button" data-select-server="${escapeHtml(server.id)}"><span class="server-status-dot ${server.status === "online" ? "online" : "offline"}"></span><span><strong>${escapeHtml(server.name)}</strong><small>${escapeHtml(server.address)} · ${escapeHtml(server.type)} ${escapeHtml(server.version)}</small></span></button><span class="server-item-actions"><button type="button" data-power="start" data-server-id="${escapeHtml(server.id)}" aria-label="Start ${escapeHtml(server.name)}">Start</button><button type="button" data-power="restart" data-server-id="${escapeHtml(server.id)}" aria-label="Restart ${escapeHtml(server.name)}">Restart</button><button type="button" data-power="stop" data-server-id="${escapeHtml(server.id)}" aria-label="Stop ${escapeHtml(server.name)}">Stop</button></span></article>`).join("") : '<div class="server-empty">No servers yet. Create one to begin.</div>';
        $("nodeList").innerHTML = nodes.length ? nodes.map((node) => `<article class="node-list-item"><div><strong>${escapeHtml(node.name)}</strong><small>${escapeHtml(node.host || "local")} · port ${escapeHtml(node.port)}</small></div><span class="node-state ${node.status === "online" ? "online" : "offline"}">${escapeHtml(node.status || "unknown")}</span>${node.id !== "local" ? `<button type="button" class="node-delete" data-delete-node="${escapeHtml(node.id)}" aria-label="Delete ${escapeHtml(node.name)}">×</button>` : ""}</article>`).join("") : '<div class="server-empty">No nodes configured.</div>';
      }
      function renderDetail() {
        const server = state.selected; $("serverDetail").hidden = !server; if (!server) return;
        $("detailServerName").textContent = server.name; $("detailServerMeta").textContent = `${server.address} · ${server.type} ${server.version} · ${server.status}`; $("detailActions").innerHTML = ["start", "restart", "stop"].map((action) => `<button class="server-button secondary" type="button" data-detail-power="${action}">${action[0].toUpperCase() + action.slice(1)}</button>`).join(""); $("editServerName").value = server.name; $("editServerAlias").value = server.ipAlias || ""; $("editServerRam").value = server.ram; $("editServerCpu").value = server.cpu; $("editServerDisk").value = server.disk; $("suspendServerButton").textContent = server.suspended ? "Unsuspend" : "Suspend";
        if (state.statsTimer) clearInterval(state.statsTimer); loadStats(); state.statsTimer = setInterval(loadStats, 8000);
      }
      async function loadOverview() { try { const body = await api("/api/servers/overview"); state.overview = body.overview || state.overview; if (state.selected) state.selected = state.overview.servers.find((server) => server.id === state.selected.id) || null; renderOverview(); renderDetail(); } catch (error) { $("serverNotice").hidden = false; $("serverNotice").textContent = error.message; $("runtimeBadge").textContent = "Unavailable"; } }
      async function selectServer(id) { try { const body = await api(`/api/servers/${encodeURIComponent(id)}`); state.selected = body.server; state.currentPath = "/"; renderOverview(); renderDetail(); loadFiles(); loadBackups(); writeConsole(`Connected to ${state.selected.name}.\n`); } catch (error) { toast(error.message, "error"); } }
      async function powerServer(id, action) { try { const body = await api(`/api/servers/${encodeURIComponent(id)}/${action}`, { method: "POST" }); state.selected = body.server || state.selected; toast(`Server ${action} signal sent.`, "success"); await loadOverview(); } catch (error) { toast(error.message, "error"); } }
      async function loadStats() { if (!state.selected) return; try { const body = await api(`/api/servers/${encodeURIComponent(state.selected.id)}/stats`); const stats = body.stats || {}; $("resourceGrid").innerHTML = `<span>CPU ${Number(stats.cpu || 0).toFixed(1)}%</span><span>RAM ${Number(stats.ram || 0).toFixed(0)} MB</span><span>Disk ${formatBytes(stats.disk || 0)}</span><span>Network ${formatBytes(stats.netIn || 0)} in · ${formatBytes(stats.netOut || 0)} out</span>`; $("consoleStatus").textContent = `Status: ${stats.status || "unknown"}`; } catch (error) { $("consoleStatus").textContent = error.message; } }
      function writeConsole(text, append = false) { const output = $("consoleOutput"); output.textContent = append ? output.textContent + text : text; output.scrollTop = output.scrollHeight; }
      async function loadFiles() { if (!state.selected) return; try { const body = await api(`/api/servers/${encodeURIComponent(state.selected.id)}/files?path=${encodeURIComponent(state.currentPath)}`); $("filePath").value = state.currentPath; const files = body.files || []; $("fileList").innerHTML = files.length ? files.map((file) => `<button class="file-item" type="button" data-file-path="${escapeHtml(file.path)}" data-file-directory="${file.isDirectory}"><span>${file.isDirectory ? "▸" : "□"} ${escapeHtml(file.name)}</span><small>${file.isDirectory ? "Directory" : formatBytes(file.size)}</small></button>`).join("") : '<div class="server-empty">Directory is empty.</div>'; } catch (error) { toast(error.message, "error"); } }
      async function openFile(filePath) { if (!state.selected) return; try { const body = await api(`/api/servers/${encodeURIComponent(state.selected.id)}/files/read?path=${encodeURIComponent(filePath)}`); state.file = filePath; $("fileEditor").value = body.file.content; $("saveFileButton").disabled = false; } catch (error) { toast(error.message, "error"); } }
      async function loadBackups() { if (!state.selected) return; try { const body = await api(`/api/servers/${encodeURIComponent(state.selected.id)}/backups`); const backups = body.backups || []; $("backupList").innerHTML = backups.length ? backups.map((backup) => `<div class="backup-item"><span><strong>${escapeHtml(backup.filename)}</strong><small>${formatBytes(backup.size)}</small></span><span><a class="server-button secondary" href="/api/servers/${encodeURIComponent(state.selected.id)}/backups/${encodeURIComponent(backup.filename)}/download">Download</a><button class="server-button danger" type="button" data-delete-backup="${escapeHtml(backup.filename)}">Delete</button></span></div>`).join("") : '<div class="server-empty">No backups yet.</div>'; } catch (error) { toast(error.message, "error"); } }
      function applyTheme(theme) { if (!theme) return; document.documentElement.style.setProperty("--accent", theme.accentColor || "#d00000"); document.documentElement.style.setProperty("--nav-text", theme.navText || "#9da3b4"); document.documentElement.style.setProperty("--nav-text-active", theme.navTextActive || "#e7e9f0"); if (theme.wallpaperUrl) document.body.style.backgroundImage = `linear-gradient(rgba(4, 5, 12, .55), rgba(4, 5, 12, .82)), url("${theme.wallpaperUrl}")`; }
      document.addEventListener("click", async (event) => { const select = event.target.closest("[data-select-server]"); if (select) return selectServer(select.dataset.selectServer); const power = event.target.closest("[data-power]"); if (power) return powerServer(power.dataset.serverId, power.dataset.power); const detailPower = event.target.closest("[data-detail-power]"); if (detailPower) return powerServer(state.selected.id, detailPower.dataset.detailPower); const file = event.target.closest("[data-file-path]"); if (file) { if (file.dataset.fileDirectory === "true") { state.currentPath = "/" + file.dataset.filePath.replace(/^\/+/, "") + "/"; loadFiles(); } else openFile(file.dataset.filePath); } const deleteBackup = event.target.closest("[data-delete-backup]"); if (deleteBackup && confirm("Delete this backup?")) { await api(`/api/servers/${encodeURIComponent(state.selected.id)}/backups/${encodeURIComponent(deleteBackup.dataset.deleteBackup)}`, { method: "DELETE" }); loadBackups(); } const deleteNode = event.target.closest("[data-delete-node]"); if (deleteNode && confirm("Delete this node?")) { await api(`/api/nodes/${encodeURIComponent(deleteNode.dataset.deleteNode)}`, { method: "DELETE" }); loadOverview(); } });
      document.querySelectorAll(".server-tab").forEach((tab) => tab.addEventListener("click", () => { document.querySelectorAll(".server-tab, .server-tab-panel").forEach((item) => item.classList.remove("active")); tab.classList.add("active"); document.querySelector(`[data-panel="${tab.dataset.tab}"]`).classList.add("active"); }));
      $("refreshServersButton").addEventListener("click", loadOverview); $("refreshStatsButton").addEventListener("click", loadStats); $("loadFilesButton").addEventListener("click", () => { state.currentPath = $("filePath").value || "/"; loadFiles(); }); $("uploadFileButton").addEventListener("click", () => $("serverFileInput").click()); $("serverFileInput").addEventListener("change", async () => { const file = $("serverFileInput").files[0]; if (!file || !state.selected) return; const form = new FormData(); form.append("file", file); form.append("path", state.currentPath); try { await api(`/api/servers/${encodeURIComponent(state.selected.id)}/files/upload`, { method: "POST", body: form }); toast("File uploaded", "success"); loadFiles(); } catch (error) { toast(error.message, "error"); } });
      $("newFileButton").addEventListener("click", async () => { const name = prompt("New file name"); if (!name || !state.selected) return; try { await api(`/api/servers/${encodeURIComponent(state.selected.id)}/files/entry`, { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ path: `${state.currentPath.replace(/\/$/, "")}/${name}`, directory: false }) }); loadFiles(); } catch (error) { toast(error.message, "error"); } }); $("newFolderButton").addEventListener("click", async () => { const name = prompt("New folder name"); if (!name || !state.selected) return; try { await api(`/api/servers/${encodeURIComponent(state.selected.id)}/files/entry`, { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ path: `${state.currentPath.replace(/\/$/, "")}/${name}`, directory: true }) }); loadFiles(); } catch (error) { toast(error.message, "error"); } });
      $("saveFileButton").addEventListener("click", async () => { if (!state.file || !state.selected) return; try { await api(`/api/servers/${encodeURIComponent(state.selected.id)}/files/write`, { method: "PUT", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ path: state.file, content: $("fileEditor").value }) }); toast("File saved", "success"); } catch (error) { toast(error.message, "error"); } });
      $("consoleForm").addEventListener("submit", async (event) => { event.preventDefault(); if (!state.selected) return; const command = $("consoleCommand").value.trim(); if (!command) return; try { await api(`/api/servers/${encodeURIComponent(state.selected.id)}/command`, { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ command }) }); writeConsole(`> ${command}\n[command accepted]\n`, true); $("consoleCommand").value = ""; } catch (error) { toast(error.message, "error"); } });
      $("createBackupButton").addEventListener("click", async () => { if (!state.selected) return; try { await api(`/api/servers/${encodeURIComponent(state.selected.id)}/backups`, { method: "POST" }); toast("Backup created", "success"); loadBackups(); } catch (error) { toast(error.message, "error"); } });
      $("packageForm").addEventListener("submit", async (event) => { event.preventDefault(); if (!state.selected) return; try { await api(`/api/servers/${encodeURIComponent(state.selected.id)}/${$("packageKind").value}/install-modrinth`, { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ projectId: $("packageProjectId").value }) }); toast("Package installed", "success"); $("packageProjectId").value = ""; } catch (error) { toast(error.message, "error"); } });
      $("saveServerButton").addEventListener("click", async () => { if (!state.selected) return; try { const body = await api(`/api/servers/${encodeURIComponent(state.selected.id)}`, { method: "PUT", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ name: $("editServerName").value, ipAlias: $("editServerAlias").value, ram: $("editServerRam").value, cpu: $("editServerCpu").value, disk: $("editServerDisk").value }) }); state.selected = body.server; toast("Server settings saved", "success"); loadOverview(); } catch (error) { toast(error.message, "error"); } });
      $("suspendServerButton").addEventListener("click", async () => { if (!state.selected) return; try { const body = await api(`/api/servers/${encodeURIComponent(state.selected.id)}/suspend`, { method: "PUT", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ suspended: !state.selected.suspended }) }); state.selected = body.server; toast(state.selected.suspended ? "Server suspended" : "Server unsuspended", "success"); loadOverview(); } catch (error) { toast(error.message, "error"); } }); $("deleteServerButton").addEventListener("click", async () => { if (!state.selected || !confirm("Delete this server and its files?")) return; try { await api(`/api/servers/${encodeURIComponent(state.selected.id)}`, { method: "DELETE" }); state.selected = null; $("serverDetail").hidden = true; toast("Server deleted", "success"); loadOverview(); } catch (error) { toast(error.message, "error"); } });
      $("openCreateServerButton").addEventListener("click", () => $("createServerDialog").showModal()); $("openNodeButton").addEventListener("click", () => $("nodeDialog").showModal());
      $("createServerForm").addEventListener("submit", async (event) => { event.preventDefault(); try { await api("/api/servers", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ name: $("newServerName").value, type: $("newServerType").value, version: $("newServerVersion").value, port: $("newServerPort").value, ram: $("newServerRam").value, disk: $("newServerDisk").value }) }); $("createServerDialog").close(); toast("Server created", "success"); loadOverview(); } catch (error) { toast(error.message, "error"); } });
      $("nodeForm").addEventListener("submit", async (event) => { event.preventDefault(); try { await api("/api/nodes", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ name: $("newNodeName").value, host: $("newNodeHost").value, port: $("newNodePort").value, scheme: $("newNodeScheme").value }) }); $("nodeDialog").close(); toast("Node added", "success"); loadOverview(); } catch (error) { toast(error.message, "error"); } });
      fetch("/api/theme").then((response) => response.json()).then(applyTheme).catch(() => {}); loadOverview();
    </script>
  </body>
</html>
